# ============================================================
# Crypto Investment Agent - environment configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real ".env" file (it is already in .gitignore).
# ============================================================

# --- Binance API credentials ---
# Get TESTNET keys at https://testnet.binance.vision/ (free, fake money).
# Only create LIVE keys on https://www.binance.com/en/my/settings/api-management
# after you have validated the bot on testnet for at least a few days.
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# --- Safety switch ---
# true  = trades against Binance's Testnet (fake money, real market data)
# false = trades with REAL MONEY. Only set this after you understand the
#         bot's behavior and have reviewed its testnet track record.
USE_TESTNET=true

# --- Market / screener (which coins the bot is even allowed to consider) ---
QUOTE_ASSET=USDT                # only scan pairs quoted in this asset (e.g. BTCUSDT, ETHUSDT, ...)
MIN_24H_QUOTE_VOLUME=20000000   # liquidity floor in USDT (24h volume) - protects the tight
                                 # stop-loss from being defeated by a wide bid/ask spread
MAX_CANDIDATES=20               # scan at most this many (most-liquid-first) symbols per cycle
EXCLUDED_BASE_ASSETS=           # optional comma list to always skip, e.g. EXCLUDED_BASE_ASSETS=DOGE,SHIB

INTERVAL=15m          # candle interval used for signals (e.g. 1m, 5m, 15m, 1h)

# --- Strategy parameters (RSI mean-reversion + SMA trend filter) ---
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
SMA_PERIOD=50

# --- Risk management: exit rules (see risk_manager.py docstring for priority order) ---
MAX_POSITION_PCT=0.20         # max fraction of available balance risked per trade

STOP_LOSS_PCT=0.015           # hard stop: close a losing position at -1.5%

TRAILING_ACTIVATION_PCT=0.02  # trailing stop arms itself once a trade is up +2%
TRAILING_DISTANCE_PCT=0.015   # ...then sells if price pulls back 1.5% from its peak

MAX_HOLD_HOURS=6               # force-close a position that hits neither stop
                                # nor trailing-stop within this many hours

CRASH_DROP_PCT=0.07            # emergency exit: sell immediately if price falls
CRASH_WINDOW_MINUTES=60        # this much (7%) within this window (60 min), instead
                                # of waiting for the normal stop-loss distance

MAX_DAILY_LOSS_PCT=0.05        # stop trading for the day after losing 5% of balance
MAX_TRADES_PER_DAY=6            # hard cap to prevent overtrading / fee bleed

# --- Profit-lock ladder ---
# Whenever the TOTAL account value (reserve + trading capital) reaches
# PROFIT_LOCK_PRINCIPAL * 2^n (e.g. 400 -> 800 -> 1600 -> 3200 -> ...),
# half of that milestone becomes an untouchable reserve (bookkeeping only -
# the funds never leave the account, the bot's API key has no withdrawal
# permission). The other half stays as trading capital. This is a ratchet:
# the reserve only ever grows, never shrinks, even if trading capital
# later loses money.
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_PRINCIPAL=400       # set this to your actual starting capital

# --- Loop timing ---
LOOP_INTERVAL_SECONDS=60   # how often the bot checks the market
